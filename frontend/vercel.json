{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ccms-api-xf1p.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://ccms-api-xf1p.onrender.com/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
